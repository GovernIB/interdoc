<?xml version="1.0" encoding="UTF-8"?>
<jboss-deployment-structure xmlns="urn:jboss:deployment-structure:1.2">
    <!--
    Permet introduïr configuracions relacionades amb el desplegament.
    Com ara ignorar mòduls del servidor si el nostre EAR conté versions més recents.
    -->
    <deployment>
        <dependencies>
            <!--   module name="org.hibernate" slot="5.3" export="true"/ -->
            <module name="org.hibernate" />
            <module name="org.apache.cxf" export="true"/>
            <module name="org.apache.cxf.impl" export="true"/>
            <module name="org.apache.ws.security" export="true"/>
            <module name="org.apache.xerces" />
            <module name="org.apache.santuario.xmlsec" export="true"/>
            <module name="org.bouncycastle" export="true"/>

            <module name="org.apache.commons.codec" export="TRUE"/>
            <module name="org.apache.commons.io" export="TRUE"/>
            <module name="org.apache.httpcomponents.core" export="TRUE"/>
            <module name="com.fasterxml.jackson.core.jackson-annotations" export="TRUE"/>
            <module name="com.fasterxml.jackson.core.jackson-core" export="TRUE"/>
            <module name="org.codehaus.jackson.jackson-core-asl" export="TRUE"/>
            <module name="com.fasterxml.jackson.core.jackson-databind" export="TRUE"/>
            <module name="org.codehaus.jackson.jackson-jaxrs" export="TRUE"/>
            <module name="org.codehaus.jackson.jackson-mapper-asl" export="TRUE"/>
            <module name="org.codehaus.jackson.jackson-xc" export="TRUE"/>
            <module name="org.jboss.ejb3" export="TRUE"/>
            <module name="org.codehaus.jettison" export="TRUE"/>
            <module name="org.apache.log4j" export="TRUE"/>
            <module name="org.jboss.logging" export="TRUE"/>
            <module name="javax.ws.rs.api" export="TRUE"/>
            <module name="org.apache.log4j" export="TRUE"/>
        </dependencies>
    </deployment>
    <sub-deployment name="interdoc-api-externa.war">
        <dependencies>
            <module name="com.google.code.gson" export="TRUE"/>
        </dependencies>
    </sub-deployment>
    <sub-deployment name="interdoc-api-interna.war">
        <dependencies>
            <module name="com.google.code.gson" export="TRUE"/>
            <module name="org.jboss.ws.api" export="TRUE"/>
        </dependencies>
    </sub-deployment>
    <sub-deployment name="interdoc-back.war">
        <dependencies>
            <module name="org.apache.commons.io" export="TRUE"/>
        </dependencies>
    </sub-deployment>
    <sub-deployment name="interdoc-ejb.jar">
        <dependencies>
            <module name="deployment.interdoc.ear" export="true"/>
            <module name="org.apache.commons.logging" export="true"/>
        </dependencies>
    </sub-deployment>
</jboss-deployment-structure>
